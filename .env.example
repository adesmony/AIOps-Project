# Runtime. Local providers are selected only by this exact value.
ENVIRONMENT=Development
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Local PostgreSQL / pgvector. Keep credentials in .env, never source control.
POSTGRES_USER=aiops
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=aiops
DATABASE_URL=postgresql://aiops:replace-with-a-local-password@localhost:5432/aiops
DATABASE_TIMEOUT_SECONDS=5

# Production Azure Database for PostgreSQL using managed identity.
AZURE_POSTGRES_HOST=
AZURE_POSTGRES_DATABASE=
AZURE_POSTGRES_USER=

# Application sessions. Use a long random secret in every environment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=incident-api
JWT_AUDIENCE=incident-web
JWT_EXPIRY_MINUTES=30
SESSION_COOKIE_NAME=incident_session

# Azure OpenAI. Development uses the deterministic local provider and ignores these.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=azure/gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
MAX_EVIDENCE_ITEMS=12
MAX_EVIDENCE_CHARS=12000
DEFAULT_LOOKBACK_MINUTES=30
MAX_LOOKBACK_DAYS=7

# Optional enhancement. The API runs with a safe no-op when unconfigured.
APPLICATIONINSIGHTS_CONNECTION_STRING=
